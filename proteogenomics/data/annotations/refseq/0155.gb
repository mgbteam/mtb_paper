                     GVALSAYEHWLRDESVSLTEALGAAFDVVGAGLDRLNQ"
     gene            790863..790952
                     /gene="mftA"
                     /locus_tag="FF955_03720"
     CDS             790863..790952
                     /gene="mftA"
                     /locus_tag="FF955_03720"
                     /inference="COORDINATES: similar to AA
                     sequence:RefSeq:YP_007409348.2"
                     /note="Mycofactocin is a putative electron carrier derived
                     from the final two amino acids, Val-Tyr, of the
                     mycofactocin precursor MftA. The first two steps of its
                     maturation are both performed by the radical SAM enzyme
                     MftC. This step is followed by separation of the modified
                     Val-Tyr from the rest of the precursor. The final steps in
                     the maturation of mycofactocin, and the eventual product,
                     both are unknown. The mycofactocin system, featuring
                     modification of a ribosomally translated precursor by a
                     radical SAM enzyme, in order to create a redox-active
                     product, and inevitable co-occurence of certain families
                     of enzymes on that product, is closely analogous to the
                     previously described PQQ system; Derived by automated
                     computational analysis using gene prediction method:
                     Protein Homology."
                     /codon_start=1
                     /transl_table=11
                     /product="mycofactocin precursor"
                     /protein_id="PRJNA544196:FF955_03720"
                     /translation="MDYETDTDTELVTETLVEEVSIDGMCGVY"
     gene            790955..791266
                     /gene="mftB"
                     /locus_tag="FF955_03725"
     CDS             790955..791266
                     /gene="mftB"
                     /locus_tag="FF955_03725"
                     /inference="COORDINATES: similar to AA
                     sequence:RefSeq:WP_003911266.1"
                     /note="MftB, a small protein, is a peptide chaperone that
                     assists the radical SAM enzyme MftC in performing two
                     modifications to the C-terminal Val-Tyr dipeptide of the
                     mycofactocin precursor peptide, MftA. MftB's role is
                     analogous to the role of PqqD in the biosynthesis of PQQ,
                     a cofactor that derives entirely from a Tyr and a Glu in
                     the precursor PqqA; Derived by automated computational
                     analysis using gene prediction method: Protein Homology."
                     /codon_start=1
                     /transl_table=11
